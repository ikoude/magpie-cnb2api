{
  "name": "magpie-cnb2api",
  "version": "0.1.0",
  "description": "A magpie provider for the cnb2api gateway in your own CNB workspace: follows the workspace address as it changes, restarts the workspace when it stops, and reports its AI credits and core-hours.",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "scripts": {
    "test": "node test/run.mjs"
  },
  "bin": {
    "magpie-cnb2api-prune": "./tools/magpie-prune.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "index.mjs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "icon.svg",
    "LICENSE",
    "docs/",
    "tools/"
  ],
  "author": "ikoude",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikoude/magpie-cnb2api.git"
  },
  "homepage": "https://github.com/ikoude/magpie-cnb2api",
  "bugs": {
    "url": "https://github.com/ikoude/magpie-cnb2api/issues"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "cnb2api",
    "cnb",
    "openai-compatible"
  ],
  "license": "MIT",
  "magpie": {
    "name": "CNB2API",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "Serves the cnb2api gateway in your own CNB workspace as a magpie provider: follows the address that changes on every restart, restarts a workspace the platform has stopped, and reports its AI credits and core-hours.",
      "zh": "把 CNB 工作区里的 cnb2api 接成 magpie 供应商。工作区地址每次重启都会变，被平台停止后不再响应；插件跟随地址变化，在停止后重新启动，并显示该工作区的 AI credits 与核时。"
    },
    "options": {
      "repo": "",
      "token": "",
      "proxyKey": "",
      "models": "deepseek-v4.1-flash",
      "branch": "main",
      "checkSeconds": 120,
      "autoStart": true,
      "port": 9001
    }
  }
}
