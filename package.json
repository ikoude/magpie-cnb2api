{
  "name": "magpie-cnb2api",
  "version": "0.2.0",
  "description": "Uses the cnb2api gateway in your own CNB workspace as a magpie provider: follows the address that changes on every restart, brings a stopped workspace back, and shows each organization's AI credits and core-hours. Accounts are keyed by \"username | org/repo\", never by email.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikoude/magpie-cnb2api.git"
  },
  "homepage": "https://github.com/ikoude/magpie-cnb2api",
  "bugs": {
    "url": "https://github.com/ikoude/magpie-cnb2api/issues"
  },
  "author": "ikoude",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./toolkit": "./toolkit.mjs",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "toolkit.mjs",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "cnb2api",
    "cnb",
    "openai-compatible",
    "provider"
  ],
  "magpie": {
    "name": "CNB2API",
    "icon": "data:image/svg+xml;base64,",
    "summary": {
      "en": "The cnb2api gateway in your CNB workspace as a provider: follows the subdomain that changes on every restart, brings a stopped workspace back, and shows each organization's AI credits. One account per \"username | org/repo\".",
      "zh": "把你 CNB 工作区里的 cnb2api 接成供应商：地址变了自动跟随、工作区停了自动拉起、按组织显示真实额度。一个账号对应一个「用户名 | 组织/仓库」。"
    },
    "options": {
      "repo": "",
      "org": "",
      "token": "",
      "proxyKey": "",
      "models": "deepseek-v4.1-flash",
      "branch": "main",
      "checkSeconds": 120,
      "autoStart": true,
      "port": 9001,
      "idleStopMinutes": 0,
      "creditFloorPercent": 1
    }
  },
  "engines": {
    "node": ">=20"
  }
}
